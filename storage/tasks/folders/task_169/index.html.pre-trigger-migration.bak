<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mini-Taschenrechner</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <div class="code-ui-wrapper">
    <div class="calculator">
      <h2>🧮 Mini-Taschenrechner</h2>

      <div class="field">
        <label for="a">Zahl A</label>
        <input id="a" type="number" step="any" data-element="a" placeholder="z. B. 12" />
      </div>

      <div class="field">
        <label for="b">Zahl B</label>
        <input id="b" type="number" step="any" data-element="b" placeholder="z. B. 3" />
      </div>

      <div class="buttons">
        <button type="button" data-run-python="true" data-run-name="plus">+</button>
        <button type="button" data-run-python="true" data-run-name="minus">−</button>
        <button type="button" data-run-python="true" data-run-name="mal">×</button>
        <button type="button" data-run-python="true" data-run-name="geteilt">÷</button>
      </div>

      <div class="result-box">
        <div><strong>Ergebnis:</strong> <span data-element="result">-</span></div>
        <div class="error" hidden><span data-element="error"></span></div>
      </div>
    </div>

    <div id="idegui-root" data-idegui-root="true"></div>
    <div id="idegui-output" data-idegui-output="true"></div>
  </div>
  <script src="ui-runtime.readonly.js"></script>
</body>
</html>